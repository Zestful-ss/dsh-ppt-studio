{
  "name": "dsh-ppt-studio",
  "version": "0.3.0",
  "description": "PPT Studio for DSH：在侧边栏逐页制作、圈选修改并导出可编辑 PPTX。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "lib",
    "assets",
    "locale",
    "catalog.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check lib/index.js && node --check lib/manager.js && node --check lib/client.js && node --check lib/project.js && node --check lib/export.js"
  },
  "dependencies": {
    "pptxgenjs": "^3.12.0",
    "tar": "7.5.22"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "author": "Zestful-ss",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zestful-ss/dsh-ppt-studio.git"
  },
  "homepage": "https://github.com/Zestful-ss/dsh-ppt-studio#readme",
  "bugs": {
    "url": "https://github.com/Zestful-ss/dsh-ppt-studio/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ppt",
    "pptx",
    "slides"
  ]
}
