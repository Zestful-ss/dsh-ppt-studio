# Intentional bundled runtime dependencies for build-free GitHub installation.
# Only the audited production packages below are published.
/node_modules/*
!/node_modules/tar/
!/node_modules/chownr/
!/node_modules/minipass/
!/node_modules/minizlib/
!/node_modules/yallist/
!/node_modules/@isaacs/
/node_modules/@isaacs/*
!/node_modules/@isaacs/fs-minipass/
!/node_modules/dsh-review-dock
*.tgz
artifacts/
.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
*.pem
*.key
.DS_Store
*.log

# Local audit and developer-profile helpers
release-audit/
scripts/prepare-integration.mjs
scripts/pins.json
